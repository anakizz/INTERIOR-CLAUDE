<style>
/* ============ 기본 설정 ============ */
:root{
  --brown-900:#2B1D14;
  --brown-800:#3B2A20;
  --brown-700:#4E382B;
  --brown-600:#5C4033;
  --brown-400:#8B6B52;
  --gold:#C8A165;
  --beige:#F7F3EF;
  --line:#E6DDD4;
  --white:#FFFFFF;
  --shadow:0 14px 40px rgba(43,29,20,.12);
  --radius:14px;
  --nav-h:74px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:var(--nav-h)}
body{
  font-family:'Nanum Gothic', 'Malgun Gothic', sans-serif;
  color:var(--brown-800);
  background:var(--white);
  line-height:1.75;
  -webkit-font-smoothing:antialiased;
}
a{text-decoration:none;color:inherit}
li{list-style:none}
img{max-width:100%;display:block}
.container{width:min(1180px,90%);margin:0 auto}
section{padding:110px 0}
.bg-beige{background:var(--beige)}

/* ============ 공통 타이포 ============ */
.tag{
  display:inline-block;font-size:13px;font-weight:700;letter-spacing:.18em;
  color:var(--gold);text-transform:uppercase;margin-bottom:14px;
}
.title{font-size:clamp(26px,3.6vw,42px);font-weight:800;line-height:1.35;letter-spacing:-.02em}
.title span{color:var(--gold)}
.desc{margin-top:16px;color:var(--brown-400);font-size:16px}
.center{text-align:center}
.center .desc{max-width:640px;margin:16px auto 0}
.divider{width:52px;height:3px;background:var(--gold);margin:22px 0}
.center .divider{margin:22px auto}

/* ============ 버튼 ============ */
.btn{
  display:inline-block;padding:15px 34px;border-radius:50px;font-weight:700;
  font-size:15px;border:2px solid transparent;cursor:pointer;
  transition:transform .25s ease, box-shadow .25s ease, background .25s ease, color .25s ease;
}
.btn-primary{background:var(--gold);color:var(--brown-900)}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(200,161,101,.45)}
.btn-ghost{border-color:rgba(255,255,255,.6);color:#fff}
.btn-ghost:hover{background:#fff;color:var(--brown-800);transform:translateY(-3px)}
.btn-dark{background:var(--brown-800);color:#fff}
.btn-dark:hover{transform:translateY(-3px);box-shadow:var(--shadow)}

/* ============ 스크롤 진행 바 ============ */
#progress{
  position:fixed;top:0;left:0;height:3px;width:0;z-index:1200;
  background:linear-gradient(90deg,var(--gold),#E4C99B);
}

/* ============ 헤더 / 책갈피 내비게이션 ============ */
header{
  position:fixed;top:0;left:0;width:100%;height:var(--nav-h);z-index:1100;
  display:flex;align-items:center;transition:background .35s ease, box-shadow .35s ease;
  background:transparent;
}
header.scrolled{background:rgba(43,29,20,.96);box-shadow:0 6px 24px rgba(0,0,0,.18)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;width:min(1180px,90%);margin:0 auto}
.logo{display:flex;align-items:center;gap:10px;color:#fff;font-weight:800;font-size:21px;letter-spacing:-.02em}
.logo i{
  width:34px;height:34px;border-radius:9px;background:var(--gold);color:var(--brown-900);
  display:grid;place-items:center;font-style:normal;font-size:15px;font-weight:800;
}
.gnb{display:flex;gap:34px}
.gnb a{
  color:rgba(255,255,255,.86);font-size:15px;font-weight:700;position:relative;padding:6px 0;
  transition:color .25s ease;
}
.gnb a::after{
  content:'';position:absolute;left:0;bottom:0;width:0;height:2px;background:var(--gold);
  transition:width .3s ease;
}
.gnb a:hover,.gnb a.active{color:#fff}
.gnb a.active::after,.gnb a:hover::after{width:100%}
.nav-cta{padding:11px 24px;font-size:14px}
.burger{display:none;flex-direction:column;gap:6px;background:none;border:0;cursor:pointer}
.burger span{width:26px;height:2px;background:#fff;transition:.3s}
.burger.on span:nth-child(1){transform:translateY(8px) rotate(45deg)}
.burger.on span:nth-child(2){opacity:0}
.burger.on span:nth-child(3){transform:translateY(-8px) rotate(-45deg)}

/* ============ 히어로 ============ */
.hero{
  position:relative;min-height:100vh;display:grid;place-items:center;text-align:center;
  color:#fff;overflow:hidden;padding:var(--nav-h) 0 60px;
}
.hero-bg{
  position:absolute;inset:-10%;z-index:-2;
  background:
    radial-gradient(1100px 600px at 70% 20%, rgba(200,161,101,.28), transparent 60%),
    linear-gradient(140deg,#2B1D14 0%,#4E382B 45%,#6B4B36 100%);
}
.hero-bg::after{
  content:'';position:absolute;inset:0;
  background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);
  background-size:64px 64px;
}
.hero h1{font-size:clamp(32px,5.6vw,62px);font-weight:800;line-height:1.28;letter-spacing:-.03em}
.hero h1 span{color:var(--gold)}
.hero p{margin:26px auto 0;max-width:620px;color:rgba(255,255,255,.86);font-size:17px}
.hero-btns{margin-top:40px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.hero-badge{
  display:inline-flex;align-items:center;gap:9px;padding:9px 20px;margin-bottom:26px;
  border:1px solid rgba(255,255,255,.3);border-radius:50px;font-size:14px;font-weight:700;
  background:rgba(255,255,255,.07);
}
.dot{width:8px;height:8px;border-radius:50%;background:var(--gold);animation:pulse 1.6s infinite}
@keyframes pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.5);opacity:.5}}
.scroll-down{
  position:absolute;bottom:34px;left:50%;transform:translateX(-50%);
  font-size:12px;letter-spacing:.2em;color:rgba(255,255,255,.7);font-weight:700;
}
.scroll-down::after{
  content:'';display:block;width:1px;height:38px;margin:10px auto 0;background:rgba(255,255,255,.5);
  animation:down 1.8s infinite;
}
@keyframes down{0%{transform:scaleY(.2);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}100%{transform:scaleY(.2);transform-origin:bottom}}

/* ============ 성과 카운터 ============ */
.stats{background:var(--brown-800);color:#fff;padding:64px 0}
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;text-align:center}
.stat b{display:block;font-size:clamp(30px,4vw,46px);font-weight:800;color:var(--gold);letter-spacing:-.02em}
.stat p{font-size:14px;color:rgba(255,255,255,.75);margin-top:6px}

/* ============ 회사 소개 ============ */
.about-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:70px;align-items:center}
.about-visual{position:relative;height:440px;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
.about-visual .layer{
  position:absolute;inset:0;
  background:linear-gradient(160deg,#6B4B36,#3B2A20 70%);
}
.about-visual .layer::after{
  content:'';position:absolute;right:-60px;bottom:-60px;width:260px;height:260px;border-radius:50%;
  background:radial-gradient(circle,rgba(200,161,101,.55),transparent 65%);
}
.about-visual .quote{
  position:absolute;left:34px;bottom:34px;color:#fff;font-weight:800;font-size:22px;line-height:1.6;
}
.about-visual .quote small{display:block;font-size:13px;font-weight:400;color:var(--gold);margin-top:10px}
.check-list{margin-top:26px;display:grid;gap:14px}
.check-list li{display:flex;gap:12px;font-size:15px}
.check-list li::before{
  content:'✓';flex:0 0 22px;height:22px;border-radius:50%;background:var(--gold);color:var(--brown-900);
  display:grid;place-items:center;font-size:12px;font-weight:800;margin-top:3px;
}

/* ============ 서비스 카드 ============ */
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:56px}
.card{
  background:var(--white);border:1px solid var(--line);border-radius:var(--radius);padding:38px 30px;
  transition:transform .35s ease, box-shadow .35s ease, border-color .35s ease;
}
.card:hover{transform:translateY(-10px);box-shadow:var(--shadow);border-color:var(--gold)}
.card .ico{
  width:56px;height:56px;border-radius:16px;display:grid;place-items:center;font-size:24px;
  background:var(--beige);margin-bottom:20px;transition:background .35s ease;
}
.card:hover .ico{background:var(--gold)}
.card h3{font-size:19px;font-weight:800;margin-bottom:10px}
.card p{font-size:15px;color:var(--brown-400)}
.card .price{margin-top:18px;font-weight:800;color:var(--brown-700);font-size:15px}

/* ============ 포트폴리오 ============ */
.filters{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:44px 0 34px}
.filters button{
  padding:10px 24px;border-radius:50px;border:1px solid var(--line);background:#fff;
  font-family:inherit;font-weight:700;font-size:14px;color:var(--brown-400);cursor:pointer;transition:.25s;
}
.filters button:hover{border-color:var(--gold);color:var(--brown-800)}
.filters button.on{background:var(--brown-800);border-color:var(--brown-800);color:#fff}
.works{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.work{
  position:relative;height:290px;border-radius:var(--radius);overflow:hidden;cursor:pointer;
  transition:opacity .35s ease, transform .35s ease;
}
.work .thumb{position:absolute;inset:0;transition:transform .6s ease}
.work:nth-child(1) .thumb{background:linear-gradient(150deg,#7A5A41,#3B2A20)}
.work:nth-child(2) .thumb{background:linear-gradient(150deg,#A98561,#54402F)}
.work:nth-child(3) .thumb{background:linear-gradient(150deg,#5C4033,#241812)}
.work:nth-child(4) .thumb{background:linear-gradient(150deg,#C8A165,#6B4B36)}
.work:nth-child(5) .thumb{background:linear-gradient(150deg,#8B6B52,#2B1D14)}
.work:nth-child(6) .thumb{background:linear-gradient(150deg,#6B4B36,#A98561)}
.work:hover .thumb{transform:scale(1.09)}
.work .info{
  position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;
  padding:26px;color:#fff;background:linear-gradient(to top,rgba(43,29,20,.85),transparent 62%);
}
.work .info small{color:var(--gold);font-weight:700;font-size:13px;letter-spacing:.08em}
.work .info h4{font-size:19px;font-weight:800;margin-top:6px}
.work.hide{display:none}

/* ============ 시공 절차 ============ */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin-top:56px}
.step{background:#fff;border-radius:var(--radius);padding:34px 26px;border-top:4px solid var(--gold);box-shadow:0 6px 20px rgba(43,29,20,.06)}
.step b{font-size:34px;font-weight:800;color:var(--line);display:block;line-height:1}
.step h4{font-size:17px;font-weight:800;margin:12px 0 8px}
.step p{font-size:14px;color:var(--brown-400)}

/* ============ 후기 ============ */
.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:56px}
.review{background:#fff;border-radius:var(--radius);padding:34px 30px;box-shadow:0 6px 20px rgba(43,29,20,.06)}
.stars{color:var(--gold);letter-spacing:3px;margin-bottom:14px}
.review p{font-size:15px;color:var(--brown-600)}
.who{display:flex;align-items:center;gap:12px;margin-top:22px;padding-top:20px;border-top:1px solid var(--line)}
.who i{width:42px;height:42px;border-radius:50%;background:var(--brown-800);color:var(--gold);display:grid;place-items:center;font-style:normal;font-weight:800}
.who strong{font-size:15px;display:block}
.who small{color:var(--brown-400);font-size:13px}

/* ============ FAQ ============ */
.faq{max-width:820px;margin:50px auto 0}
.qa{border-bottom:1px solid var(--line)}
.qa button{
  width:100%;background:none;border:0;text-align:left;padding:22px 40px 22px 0;cursor:pointer;
  font-family:inherit;font-size:16px;font-weight:700;color:var(--brown-800);position:relative;
}
.qa button::after{content:'+';position:absolute;right:6px;top:20px;font-size:22px;color:var(--gold);transition:transform .3s}
.qa.open button::after{transform:rotate(45deg)}
.qa .ans{max-height:0;overflow:hidden;transition:max-height .4s ease}
.qa .ans p{padding:0 0 22px;font-size:15px;color:var(--brown-400)}

/* ============ 문의 CTA ============ */
.contact{background:var(--brown-900);color:#fff}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start}
.contact .desc{color:rgba(255,255,255,.7)}
.info-list{margin-top:32px;display:grid;gap:18px}
.info-list li{display:flex;gap:14px;align-items:center;font-size:15px;color:rgba(255,255,255,.85)}
.info-list i{width:44px;height:44px;border-radius:12px;background:rgba(200,161,101,.15);color:var(--gold);display:grid;place-items:center;font-style:normal}
form{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:var(--radius);padding:36px}
.field{margin-bottom:16px}
.field label{display:block;font-size:13px;font-weight:700;color:var(--gold);margin-bottom:8px}
.field input,.field select,.field textarea{
  width:100%;padding:14px 16px;border-radius:10px;border:1px solid rgba(255,255,255,.18);
  background:rgba(255,255,255,.05);color:#fff;font-family:inherit;font-size:15px;outline:none;transition:.25s;
}
.field input:focus,.field select,.field textarea:focus{border-color:var(--gold)}
.field select option{color:#000}
.field textarea{resize:vertical;min-height:96px}
form .btn{width:100%;margin-top:8px}
.agree{font-size:13px;color:rgba(255,255,255,.6);margin-top:14px;text-align:center}
.msg{display:none;margin-top:16px;padding:14px;border-radius:10px;background:rgba(200,161,101,.2);color:var(--gold);font-size:14px;text-align:center;font-weight:700}

/* ============ 푸터 ============ */
footer{background:#1E140E;color:rgba(255,255,255,.6);padding:56px 0 30px;font-size:14px}
.f-top{display:flex;justify-content:space-between;gap:30px;flex-wrap:wrap;padding-bottom:28px;border-bottom:1px solid rgba(255,255,255,.1)}
.f-links{display:flex;gap:22px;flex-wrap:wrap}
.f-links a:hover{color:var(--gold)}
.f-bot{padding-top:22px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:13px}

/* ============ 플로팅 / 탑 버튼 ============ */
#top{
  position:fixed;right:24px;bottom:24px;width:50px;height:50px;border-radius:50%;border:0;cursor:pointer;
  background:var(--brown-800);color:var(--gold);font-size:18px;z-index:1000;opacity:0;pointer-events:none;
  transition:opacity .3s ease, transform .3s ease;box-shadow:var(--shadow);
}
#top.show{opacity:1;pointer-events:auto}
#top:hover{transform:translateY(-4px)}
.floating-call{
  position:fixed;right:24px;bottom:86px;z-index:1000;background:var(--gold);color:var(--brown-900);
  padding:13px 22px;border-radius:50px;font-weight:800;font-size:14px;box-shadow:var(--shadow);
  animation:float 2.6s ease-in-out infinite;
}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}

/* ============ 스크롤 등장 애니메이션 ============ */
.reveal{opacity:0;transform:translateY(38px);transition:opacity .8s ease, transform .8s ease}
.reveal.in{opacity:1;transform:none}
.reveal.d1{transition-delay:.12s}.reveal.d2{transition-delay:.24s}
.reveal.d3{transition-delay:.36s}.reveal.d4{transition-delay:.48s}

/* ============ 반응형 ============ */
@media (max-width:960px){
  .about-grid,.contact-grid{grid-template-columns:1fr;gap:44px}
  .cards,.works,.steps,.reviews{grid-template-columns:repeat(2,1fr)}
  .stat-grid{grid-template-columns:repeat(2,1fr);gap:34px}
  .gnb{
    position:fixed;top:var(--nav-h);left:0;width:100%;flex-direction:column;gap:0;
    background:rgba(43,29,20,.98);padding:10px 0;transform:translateY(-140%);transition:transform .4s ease;
  }
  .gnb.open{transform:translateY(0)}
  .gnb a{display:block;padding:16px 7%;border-bottom:1px solid rgba(255,255,255,.07)}
  .gnb a::after{display:none}
  .burger{display:flex}
  .nav-cta{display:none}
  section{padding:80px 0}
}
@media (max-width:600px){
  .cards,.works,.steps,.reviews{grid-template-columns:1fr}
  .about-visual{height:320px}
  .floating-call{display:none}
}
</style>
</head>
